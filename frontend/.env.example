# Copy to frontend/.env.local for local overrides. Never put secrets here: every VITE_ variable
# is embedded in the public JavaScript bundle.

# Leave unset for local development (Vite proxies /api and /ws to http://localhost:8000).
# For production builds (Netlify/Vercel) set it to your deployed backend, including /api:
# VITE_API_URL=https://bloodbridge-api.onrender.com/api
