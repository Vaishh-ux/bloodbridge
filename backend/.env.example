# Copy to backend/.env and fill in. Never commit the real .env file.

ENVIRONMENT=development            # set to "production" when deployed

# PostgreSQL connection string (Render/Neon/Supabase "postgres://..." URLs are accepted too).
# Leave unset locally to use a SQLite file (bloodbridge_dev.db) for quick experiments.
DATABASE_URL=postgresql://bloodbridge:CHANGE_ME@localhost:5432/bloodbridge

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated frontend origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Matching engine (weights should add up to 1.0)
WEIGHT_DISTANCE=0.30
WEIGHT_AVAILABILITY=0.20
WEIGHT_ELIGIBILITY=0.20
WEIGHT_EMERGENCY_PRIORITY=0.15
WEIGHT_RESPONSE_HISTORY=0.10
WEIGHT_RELIABILITY=0.05
MAX_MATCH_DISTANCE_KM=50
NOTIFY_TOP_N_DONORS=10

# System screening criteria shown to donors (confirm against your local blood-bank rules)
MIN_DONATION_INTERVAL_DAYS=90
MIN_DONOR_AGE=18
MAX_DONOR_AGE=65

# Decimal places kept when publishing request locations (2 = roughly 1 km)
PUBLIC_LOCATION_DECIMALS=2

# Optional: serve the built frontend from this API (path to frontend/dist)
FRONTEND_DIST=

# Not implemented yet (in-app + WebSocket notifications only). Reserved for future providers:
# EMAIL_API_KEY=
# SMS_API_KEY=
